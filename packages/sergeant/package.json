{
  "name": "@terros/sergeant",
  "version": "0.0.0",
  "private": true,
  "description": "The Sergeant 2 app: executes proposed actions through the Gate, the per-task loop, and the long-running service. Nothing depends on it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
