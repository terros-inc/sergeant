    "canary": "node src/canary.ts",
    "live-check": "node src/live-check.ts",
    "smoke": "node src/smoke.ts",
    "evidence": "node src/evidence.ts",
    "serve": "node src/serve.ts"
  },
  "dependencies": {
    "@terros/sergeant-contracts": "workspace:*",
    "@terros/sergeant-github": "workspace:*",
    "@terros/sergeant-linear": "workspace:*",
    "@terros/sergeant-reasoning": "workspace:*",
    "@terros/sergeant-runner": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
