{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "boundaries": {
    "tags": {
      "contracts": { "dependencies": { "allow": [] } },
      "adapter": { "dependencies": { "allow": ["contracts"] } },
      "client": { "dependencies": { "allow": ["contracts"] }, "dependents": { "allow": [] } },
      "app": { "dependents": { "allow": [] } }
    }
  },
  "tasks": {
    "//#check-file-size": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint", "//#check-file-size"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    }
  }
}
