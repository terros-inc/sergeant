# The Sergeant 2 service (`serve`), installed by install.sh. Its state is on the data volume.
[Unit]
Description=Sergeant 2 service
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/var/lib/sergeant

[Service]
User=sergeant
WorkingDirectory=/opt/sergeant/src/packages/sergeant
ExecStart=/usr/bin/node src/serve.ts --config /etc/sergeant/installation.json --state-dir /var/lib/sergeant/state --host 127.0.0.1 --port 8080
# SIGTERM only to serve: it stops intake and ends each task at its next poll, never mid-turn, so a
# reasoning turn's `claude` child must not get the signal too. Whatever is left at the timeout is killed.
KillMode=mixed
TimeoutStopSec=15min
Restart=on-failure
RestartSec=30
StandardOutput=append:/var/log/sergeant/serve.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
