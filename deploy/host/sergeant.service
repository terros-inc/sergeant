# The Sergeant 2 service (`serve`), installed by install.sh. Its state is on the data volume.
[Unit]
Description=Sergeant 2 service
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/var/lib/sergeant

[Service]
User=sergeant
WorkingDirectory=/opt/sergeant/src/packages/sergeant
# SERGEANT_CONFIG_PARAMETER: the parameter an approver's `sgt admin repo add|remove` rewrites (TECH-5193).
EnvironmentFile=/etc/sergeant/host.env
ExecStart=/usr/bin/node src/serve.ts --config /etc/sergeant/installation.json --state-dir /var/lib/sergeant/state --host 127.0.0.1 --port 8080
# SIGTERM only to serve: it stops intake and gives each task a bounded graceful stop, so a reasoning
# turn's `claude` child does not receive the first signal. The process enforces its own 5 s deadline;
# systemd remains a final backstop and kills anything left after it.
KillMode=mixed
TimeoutStopSec=15s
Restart=on-failure
RestartSec=30
StandardOutput=append:/var/log/sergeant/serve.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
